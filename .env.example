# -------------------------------------------------------------
# SmartReview SaaS - Environment Variables (Production / Local)
# -------------------------------------------------------------

# Supabase PostgreSQL Connection (Transaction Pooler for Serverless / Vercel)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.ckcslzbwebjorfbgezhd:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session Mode for Prisma db push / migrations)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.ckcslzbwebjorfbgezhd:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Authentication Secrets (Generate secure random 32+ char strings)
JWT_SECRET="smart-review-super-secret-jwt-key-2026-prod-xyz"
NEXTAUTH_SECRET="smart-review-super-secret-jwt-key-2026-prod-xyz"

# Public App URL (Your Vercel domain or custom domain in production)
NEXT_PUBLIC_APP_URL="https://smart-review.vercel.app"

# AI Keyword & Tone Weaving Engine (Google Gemini API - Optional)
GEMINI_API_KEY=""

# Razorpay Payment Gateway (Optional for SaaS billing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
PAYMENT_CURRENCY="INR"
