generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  password     String
  role         String    @default("BUSINESS_ADMIN") // "SUPER_ADMIN" or "BUSINESS_ADMIN"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
}

model Business {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  tagline         String?
  logoUrl         String?
  primaryColor    String      @default("#2563eb")
  googlePlaceId   String?
  googleReviewUrl String      @default("")
  tripadvisorReviewUrl String? @default("")
  reviewPlatform  String      @default("GOOGLE") // "GOOGLE", "TRIPADVISOR", "BOTH"
  tripadvisorEnabled Boolean  @default(true)
  phone           String?
  email           String?
  address         String?
  city            String?
  category        String?     // e.g., Restaurant, Dental, Salon, etc.
  keywords        String      @default("friendly staff, great quality, excellent service, highly recommended")
  targetTone      String      @default("enthusiastic, authentic, and detailed")
  minGoogleStar   Int         @default(4)
  status          String      @default("ACTIVE") // "ACTIVE", "SUSPENDED"

  // Agency / White Label Branding
  poweredByText   String?     @default("Unbox Studio")
  poweredByUrl    String?     @default("https://unboxstudio.com")
  
  // Subscription & Billing Lifecyle
  subscriptionStatus String   @default("ACTIVE") // "ACTIVE", "DUE", "SUSPENDED", "TRIAL"
  planTier           String   @default("GROWTH") // "STARTER", "GROWTH", "PRO", "ENTERPRISE"
  billingCycle       String   @default("MONTHLY") // "MONTHLY", "ANNUAL"
  planPrice          Float    @default(49.0)
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  lastPaymentDate    DateTime?
  billingNotes       String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users           User[]
  feedbacks       Feedback[]
  scanLogs        ScanLog[]
  standeeOrders   StandeeOrder[]
  smartTags       SmartTag[]
}

model StandeeOrder {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactName     String
  contactPhone    String
  shippingAddress String
  city            String?
  postalCode      String?
  standeeType     String    @default("ACRYLIC_A6") // "ACRYLIC_A6", "WOODEN_A5", "METAL_TENT"
  quantity        Int       @default(1)
  totalPrice      Float     @default(499)
  status          String    @default("PENDING") // "PENDING", "PROCESSING", "SHIPPED", "DELIVERED"
  trackingNumber  String?
  courierNotes    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Feedback {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating          Int
  comment         String
  customerName    String?
  customerContact String?
  status          String    @default("NEW") // "NEW", "IN_PROGRESS", "RESOLVED"
  internalNotes   String?
  createdAt       DateTime  @default(now())
}

model ScanLog {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating      Int?
  action      String    // "QR_SCANNED", "LOW_RATING_SUBMITTED", "HIGH_RATING_SUBMITTED", "COPIED_TO_GOOGLE"
  userAgent   String?
  createdAt   DateTime  @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique // "STARTER", "GROWTH", "PRO", "ENTERPRISE", or custom
  name         String   // "Starter Launch", "Growth Pro", "Enterprise Elite"
  description  String?  // "Perfect for single location clinics & cafes"
  monthlyPrice Float    @default(999)
  annualPrice  Float    @default(9999)
  currency     String   @default("INR")
  features     String   // Newline or comma separated feature list
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique // e.g. "UNBOX50"
  description   String?   // "50% off for first 3 months"
  discountType  String    @default("PERCENTAGE") // "PERCENTAGE" or "FLAT"
  discountValue Float     // 50 (%) or 500 (INR)
  minOrderValue Float     @default(0)
  maxUses       Int?      // null for unlimited
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime? // expiration
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Offer {
  id             String    @id @default(cuid())
  title          String    // "Diwali Festive Launch Offer"
  subtitle       String?   // "Get a Free Custom Acrylic Standee + 30% Off on Annual Plan"
  badgeText      String?   // "LIMITED TIME", "POPULAR", "FESTIVE"
  bannerColor    String    @default("#2563eb") // Hex color for banner
  couponCode     String?   // Linked coupon code e.g. "FESTIVE30"
  targetAudience String    @default("ALL") // "ALL", "ACTIVE", "DUE", "NEW"
  ctaText        String    @default("Claim Offer")
  ctaLink        String?   // e.g. "/dashboard?tab=billing"
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}


model SmartTag {
  id           String    @id @default(cuid())
  tagCode      String    @unique // e.g. "TAG-849201" or "QR-93821"
  batchCode    String    // e.g. "BATCH-2026-NOV"
  type         String    @default("QR_NFC") // "QR_NFC", "NFC_CARD", "QR_STAND", "NFC_COIN"
  status       String    @default("UNASSIGNED") // "UNASSIGNED", "ASSIGNED", "REVOKED"
  label        String?   // e.g. "Table 4", "Main Reception", "Billing Counter"

  // Linked business (optional until claimed/fed with data)
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  assignedAt   DateTime?
  assignedBy   String?   // Admin/User email or name who linked it
  scanCount    Int       @default(0)
  lastScanned  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
